{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;32m Hardware\u001b[0m"
    },
    {
      "type": "host",
      "key": "  PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "  ",
      "showPeCoreCount": true,
      "keyColor": "bright_green"
    },
    {
      "type": "gpu",
      "key": "  󰢮",
      "detectionMethod": "pci",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "  󰍹",
      "keyColor": "bright_green"
    },
    {
      "type": "disk",
      "key": "  󰋊",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "  󰑭",
      "keyColor": "bright_green"
    },
    {
      "type": "swap",
      "key": "  󰓡",
      "keyColor": "green"
    },
    {
      "type": "battery",
      "key": "  󰂄",
      "keyColor": "bright_green"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;34m Software\u001b[0m"
    },
    {
      "type": "os",
      "key": "  ",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "  ",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "  ",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "  ",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "  ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "  󰏖",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;35m󱫐 Uptime / Age\u001b[0m"
    },
    {
      "type": "command",
      "key": "  󱦟",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "  󰅐",
      "keyColor": "yellow"
    },
    {
      "type": "datetime",
      "key": "  ",
      "keyColor": "magenta",
      "format": "{1}/{3}/{11} {14}:{17}"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 4,
      "symbol": "circle"
    }
  ]
}
